<?php
/**
 * Luma-style layered navigation: accordion opens sections that have an active selection.
 *
 * Detection uses filter items (isSelected) plus layer state, so it works for params like style_bags[].
 *
 * @var \Magento\LayeredNavigation\Block\Navigation $block
 */

/**
 * @param \Magento\Catalog\Model\Layer\Filter\FilterInterface $filter
 */
$filterHasActiveSelection = static function ($filter) use ($block): bool {
    foreach ($filter->getItems() as $item) {
        if ($item instanceof \Magento\Catalog\Model\Layer\Filter\Item
            && method_exists($item, 'isSelected')
            && $item->isSelected()) {
            return true;
        }
    }
    try {
        $requestVar = $filter->getRequestVar();
        foreach ($block->getLayer()->getState()->getFilters() as $stateItem) {
            if ($stateItem->getFilter()->getRequestVar() === $requestVar) {
                return true;
            }
        }
    } catch (\Throwable $e) {
        // Layer state can be unavailable during some renders; treat as no match.
        unset($e);
    }
    return false;
};

$accordionActiveIndices = [];
$filterPosition = 0;
foreach ($block->getFilters() as $filter) {
    if ($filter->getItemsCount()) {
        if ($filterHasActiveSelection($filter)) {
            $accordionActiveIndices[] = $filterPosition;
        }
        $filterPosition++;
    }
}

$hasActiveAccordionPanels = $accordionActiveIndices !== [];
$multipleCollapsible = count($accordionActiveIndices) > 1;
$accordionMageInit = [
    'accordion' => [
        'openedState' => 'active',
        'collapsible' => true,
        'active' => $hasActiveAccordionPanels ? $accordionActiveIndices : false,
        'multipleCollapsible' => $multipleCollapsible,
    ],
];
$accordionMageInitJson = json_encode(
    $accordionMageInit,
    JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP
);
if ($accordionMageInitJson === false) {
    $accordionMageInitJson = '{"accordion":{'
        . '"openedState":"active","collapsible":true,"active":false,"multipleCollapsible":false}}';
}
?>
<?php if ($block->canShowBlock()): ?>
    <style>
        /* If mage/accordion skips "active" indices, still show sections that have applied filters */
        #narrow-by-list .filter-options-item._filter-active > [data-role="content"] {
            display: block !important;
        }
        #narrow-by-list .filter-options-item._filter-active > [data-role="title"] {
            border-bottom: 0;
        }
    </style>
    <div class="block filter" id="layered-filter-block" data-mage-init='
    {
        "collapsible":
        {
            "openedState": "active",
            "collapsible": true,
            "active": false,
            "collateral":
            {
                "openedState": "filter-active",
                "element": "body"
            }
        }
    }'>
        <?php $filtered = count($block->getLayer()->getState()->getFilters()) ?>
        <div class="block-title filter-title" data-count="<?= /* @noEscape */ $filtered ?>">
            <strong data-role="title"><?= $escaper->escapeHtml(__('Shop By')); ?></strong>
        </div>
        <div class="block-content filter-content">
            <?= $block->getChildHtml('state') ?>

            <?php if ($block->getLayer()->getState()->getFilters()): ?>
                <div class="block-actions filter-actions">
                    <a href="<?= $escaper->escapeUrl($block->getClearUrl()) ?>" class="action clear filter-clear">
                        <span><?= $escaper->escapeHtml(__('Clear All')) ?></span>
                    </a>
                </div>
            <?php endif; ?>
            <?php $wrapOptions = false; ?>
            <?php foreach ($block->getFilters() as $filter): ?>
                <?php if ($filter->getItemsCount()): ?>
                    <?php if (!$wrapOptions): ?>
                        <strong role="heading" aria-level="2" class="block-subtitle filter-subtitle">
                            <?= $escaper->escapeHtml(__('Shopping Options')) ?>
                        </strong>
                        <div class="filter-options"
                             id="narrow-by-list"
                             data-role="content"
                             data-mage-init='<?= /* @noEscape */ $accordionMageInitJson ?>'>
                        <?php $wrapOptions = true;
                        endif; ?>
                    <?php $sectionActive = $filterHasActiveSelection($filter); ?>
                    <div data-role="collapsible"
                         class="filter-options-item<?= $sectionActive ? ' _filter-active' : '' ?>">
                        <div data-role="title" class="filter-options-title">
                            <?= $escaper->escapeHtml(__($filter->getName())) ?>
                        </div>
                        <div data-role="content" class="filter-options-content">
                            <?= /* @noEscape */ $block->getChildBlock('renderer')->render($filter) ?>
                        </div>
                    </div>
                <?php endif; ?>
            <?php endforeach; ?>
            <?php if ($wrapOptions): ?>
                </div>
            <?php else: ?>
                <script>
                    require([
                        'jquery'
                    ], function ($) {
                        $('#layered-filter-block').addClass('filter-no-options');
                    });
                </script>
            <?php endif; ?>
        </div>
    </div>
<?php endif; ?>
