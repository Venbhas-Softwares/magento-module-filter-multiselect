<?php
/**
 * Loaded from before.body.end so it always renders (Hyvä x-if does not run inline scripts in filter.phtml).
 * Uses a static asset so Luma works: child blocks under catalog.leftnav are never output — view.phtml only
 * calls getChildHtml('state') and the renderer, so filter-init-luma.phtml never appeared in the DOM.
 *
 * @var \Magento\Framework\View\Element\Template $block
 */
?>
<script
    src="<?= $escaper->escapeUrl(
        $block->getViewFileUrl('Venbhas_FilterMultiselect::js/venbhas-filter-multiselect.js')
    ) ?>"
    defer
></script>
