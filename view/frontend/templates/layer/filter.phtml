<?php
/**
 * Venbhas FilterMultiselect - Filter item template
 *
 * Renders attribute filter items as checkboxes (multi-select) or links (single-select).
 * Price filters always render as single-select links regardless of admin configuration.
 *
 * @var \Magento\LayeredNavigation\Block\Navigation\FilterRenderer $block
 * @var \Magento\Catalog\Model\Layer\Filter\Item[] $filterItems
 * @var \Magento\Framework\Escaper $escaper
 * @var \Venbhas\FilterMultiselect\ViewModel\FilterConfig $filterConfig
 */

/** @var \Venbhas\FilterMultiselect\ViewModel\FilterConfig $filterConfig */
$filterConfig = $block->getData('venbhas_filter_config');
$isMultiSelectEnabled = $filterConfig ? $filterConfig->isEnabled() : true;
$showProductCount = $filterConfig ? $filterConfig->shouldDisplayProductCount() : false;

// FilterRenderer::render() assigns filterItems but never calls setFilter(),
// so $block->getFilter() returns null. Obtain the filter from the first item instead.
$filter = $block->getFilter() ?? (!empty($filterItems) ? $filterItems[0]->getFilter() : null);
$isPriceFilter = $filter && ($filter->getRequestVar() === 'price');

// Price filters are always single-select links; attribute filters follow admin config.
$useCheckboxes = !$isPriceFilter && $isMultiSelectEnabled;
?>
<ol class="items">
    <?php foreach ($filterItems as $filterItem): ?>
        <?php
        /** @var \Venbhas\FilterMultiselect\Model\Layer\Filter\Item $filterItem */
        if ($useCheckboxes) {
            $isSelected = $filterItem->isSelected();
            $filterUrl  = $isSelected ? $filterItem->getRemoveUrl() : $filterItem->getUrl();
        } else {
            $isSelected = $filterItem->isSingleSelectSelected();
            $filterUrl  = $isSelected
                ? $filterItem->getSingleSelectRemoveUrl()
                : $filterItem->getSingleSelectUrl();
        }
        ?>
        <li class="item<?= $isSelected ? ' active' : '' ?>">
            <?php if ($useCheckboxes): ?>
                <?php $itemId = 'filter-item-' . $escaper->escapeHtmlAttr($filterItem->getValue()); ?>
                <input type="checkbox"
                       class="filter-checkbox"
                       id="<?= $itemId ?>"
                       <?= $isSelected ? 'checked="checked"' : '' ?>
                       data-url="<?= $escaper->escapeHtmlAttr($filterUrl) ?>"
                />
                <label for="<?= $itemId ?>">
                    <?= /* @noEscape */ $filterItem->getLabel() ?>
                    <?php if ($showProductCount): ?>
                        <span class="count">
                            <?= (int)$filterItem->getCount() ?>
                            <span class="filter-count-label">
                                <?= $escaper->escapeHtml((string)__('item')) ?>
                            </span>
                        </span>
                    <?php endif; ?>
                </label>
            <?php else: ?>
                <a href="<?= $escaper->escapeUrl($filterUrl) ?>"<?= $isSelected ? ' class="current"' : '' ?>>
                    <?= /* @noEscape */ $filterItem->getLabel() ?>
                    <?php if ($showProductCount): ?>
                        <span class="count">
                            <?= (int)$filterItem->getCount() ?>
                            <span class="filter-count-label">
                                <?= $escaper->escapeHtml((string)__('item')) ?>
                            </span>
                        </span>
                    <?php endif; ?>
                </a>
            <?php endif; ?>
        </li>
    <?php endforeach; ?>
</ol>

<?php if ($useCheckboxes): ?>
<script type="text/x-magento-init">
{
    ".items": {
        "Venbhas_FilterMultiselect/js/filter-multiselect": {}
    }
}
</script>
<?php endif; ?>
